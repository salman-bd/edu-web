{  
  "compilerOptions": {  
    "target": "ES2017",                            // Supports modern JS features.  
    "lib": ["dom", "dom.iterable", "esnext"],     // Enable DOM and ES next features.  
    "allowJs": false,                              // Set to false if only TypeScript files are used.  
    "skipLibCheck": true,                          // Skip type checking of declaration files.  
    "strict": true,                                // Enable all strict type checks for safety.  
    "noEmit": true,                                // Prevent emitting output files.  
    "esModuleInterop": true,                       // Enable interop with CommonJS modules.  
    "allowSyntheticDefaultImports": true,          // Allow default imports from modules with no default exports.  
    "module": "esnext",                            // Use ESNext module resolution.  
    "moduleResolution": "bundler",                 // Use Next.js specific bundler resolution.  
    "resolveJsonModule": true,                     // Allows importing .json files as modules.  
    "isolatedModules": true,                        // Ensure every file can be transpiled separately.  
    "jsx": "preserve",                             // Preserve JSX for Next.js processing.  
    "incremental": true,                           // Enables incremental compilation to speed up builds.  
    "plugins": [  
      {  
        "name": "next"  
      }  
    ],  
    "paths": {  
      "@/*": ["./src/*"]                          // Alias setup for cleaner imports.  
    }  
  },  
  "include": [  
    "next-env.d.ts",  
    "**/*.ts",  
    "**/*.tsx",  
    ".next/types/**/*.ts"  
  ],  
  "exclude": [  
    "node_modules",  
    "**/*.spec.ts",                               // Exclude test files to improve compilation time.  
    "**/*.test.tsx"  
  ]  
}